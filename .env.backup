# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=votre_mot_de_passe_redis
REDIS_DB=0
REDIS_PREFIX=myapp:

# AWS
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=eu-west-1
AWS_BUCKET_NAME=your-bucket-name

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Fichiers
MAX_FILE_SIZE=5000000
FILE_UPLOAD_PATH=./public/uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf
MAX_FILES_PER_REQUEST=5

# Sécurité
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
CORS_ORIGIN=http://localhost:3001
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
SESSION_SECRET=your-session-secret
ENCRYPTION_KEY=your-encryption-key

# Logging
LOG_LEVEL=debug
LOG_FORMAT=combined
LOG_FILE_PATH=./logs/app.log
MORGAN_FORMAT=dev
SENTRY_DSN=your_sentry_dsn

# Swagger
SWAGGER_TITLE=Votre API
SWAGGER_DESCRIPTION=Documentation de votre API
SWAGGER_VERSION=1.0.0
SWAGGER_PATH=/api-docs

# Internationalisation
DEFAULT_LOCALE=fr
SUPPORTED_LOCALES=fr,en
I18N_DIRECTORY=src/locales

# Monitoring
ENABLE_STATUS_MONITOR=true
NEW_RELIC_LICENSE_KEY=your_license_key
NEW_RELIC_APP_NAME=your_app_name
PROMETHEUS_METRICS_PATH=/metrics

# OAuth
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# WebSocket
WS_PATH=/websocket
SOCKET_IO_PATH=/socket.io

# Queue
REDIS_QUEUE_PREFIX=queue:
BULL_QUEUE_NAME=main-queue
AGENDA_DB_COLLECTION=agendaJobs
QUEUE_CONCURRENCY=3

# Analytics
ANALYTICS_WRITE_KEY=your_write_key
SEGMENT_WRITE_KEY=your_segment_key

# Cache
CACHE_TTL=3600
CACHE_PREFIX=cache:

# Tests
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=testpassword

# CI/CD
DOCKER_REGISTRY=your-registry
DOCKER_IMAGE_NAME=your-image-name
DEPLOY_TARGET=production